+++loops
***timesRepeat: with 0 - no output
!I! 0

<?xml version="1.0" encoding="UTF-8"?>
<program language="SOL26" description="timesRepeat zero">
  <class name="Main" parent="Object">
    <method selector="run">
      <block arity="0">
        <assign order="1">
          <var name="_"/>
          <expr>
            <send selector="timesRepeat:">
              <expr><literal class="Integer" value="0"/></expr>
              <arg order="1">
                <expr>
                  <block arity="0">
                    <assign order="1">
                      <var name="_"/>
                      <expr>
                        <send selector="show:">
                          <expr><literal class="class" value="Transcript"/></expr>
                          <arg order="1"><expr><literal class="String" value="should not print"/></expr></arg>
                        </send>
                      </expr>
                    </assign>
                  </block>
                </expr>
              </arg>
            </send>
          </expr>
        </assign>
      </block>
    </method>
  </class>
</program>
