+++strings
***String startsWith:endsBefore: substring
!I! 0

<?xml version="1.0" encoding="UTF-8"?>
<program language="SOL26" description="String substring">
  <class name="Main" parent="Object">
    <method selector="run">
      <block arity="0">
        <assign order="1">
          <var name="s"/>
          <expr>
            <send selector="startsWith:endsBefore:">
              <expr><literal class="String" value="hello world"/></expr>
              <arg order="1"><expr><literal class="Integer" value="1"/></expr></arg>
              <arg order="2"><expr><literal class="Integer" value="6"/></expr></arg>
            </send>
          </expr>
        </assign>
        <assign order="2">
          <var name="_"/>
          <expr>
            <send selector="show:">
              <expr><literal class="class" value="Transcript"/></expr>
              <arg order="1"><expr><var name="s"/></expr></arg>
            </send>
          </expr>
        </assign>
      </block>
    </method>
  </class>
</program>
