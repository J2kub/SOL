+++basic
***String concatenation with ,
!I! 0

<?xml version="1.0" encoding="UTF-8"?>
<program language="SOL26" description="String concat">
  <class name="Main" parent="Object">
    <method selector="run">
      <block arity="0">
        <assign order="1">
          <var name="s"/>
          <expr>
            <send selector=",">
              <expr><literal class="String" value="Hello, "/></expr>
              <arg order="1"><expr><literal class="String" value="World!"/></expr></arg>
            </send>
          </expr>
        </assign>
        <assign order="2">
          <var name="_"/>
          <expr>
            <send selector="show:">
              <expr><literal class="class" value="Transcript"/></expr>
              <arg order="1"><expr><var name="s"/></expr></arg>
            </send>
          </expr>
        </assign>
      </block>
    </method>
  </class>
</program>
