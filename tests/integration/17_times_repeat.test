+++loops
***timesRepeat: prints 1 to 5
!I! 0

<?xml version="1.0" encoding="UTF-8"?>
<program language="SOL26" description="timesRepeat">
  <class name="Main" parent="Object">
    <method selector="run">
      <block arity="0">
        <assign order="1">
          <var name="_"/>
          <expr>
            <send selector="timesRepeat:">
              <expr><literal class="Integer" value="5"/></expr>
              <arg order="1">
                <expr>
                  <block arity="1">
                    <parameter order="1" name="i"/>
                    <assign order="1">
                      <var name="_"/>
                      <expr>
                        <send selector="show:">
                          <expr><literal class="class" value="Transcript"/></expr>
                          <arg order="1">
                            <expr>
                              <send selector="asString">
                                <expr><var name="i"/></expr>
                              </send>
                            </expr>
                          </arg>
                        </send>
                      </expr>
                    </assign>
                  </block>
                </expr>
              </arg>
            </send>
          </expr>
        </assign>
      </block>
    </method>
  </class>
</program>
