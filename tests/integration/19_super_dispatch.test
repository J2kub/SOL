+++oop
***super dispatches to parent method
!I! 0

<?xml version="1.0" encoding="UTF-8"?>
<program language="SOL26" description="super dispatch">
  <class name="A" parent="Object">
    <method selector="greet">
      <block arity="0">
        <assign order="1">
          <var name="_"/>
          <expr>
            <send selector="show:">
              <expr><literal class="class" value="Transcript"/></expr>
              <arg order="1"><expr><literal class="String" value="hello from A"/></expr></arg>
            </send>
          </expr>
        </assign>
      </block>
    </method>
  </class>
  <class name="B" parent="A">
    <method selector="greet">
      <block arity="0">
        <assign order="1">
          <var name="_"/>
          <expr>
            <send selector="greet">
              <expr><var name="super"/></expr>
            </send>
          </expr>
        </assign>
        <assign order="2">
          <var name="_"/>
          <expr>
            <send selector="show:">
              <expr><literal class="class" value="Transcript"/></expr>
              <arg order="1"><expr><literal class="String" value="hello from B"/></expr></arg>
            </send>
          </expr>
        </assign>
      </block>
    </method>
  </class>
  <class name="Main" parent="Object">
    <method selector="run">
      <block arity="0">
        <assign order="1">
          <var name="b"/>
          <expr>
            <send selector="new">
              <expr><literal class="class" value="B"/></expr>
            </send>
          </expr>
        </assign>
        <assign order="2">
          <var name="_"/>
          <expr>
            <send selector="greet">
              <expr><var name="b"/></expr>
            </send>
          </expr>
        </assign>
      </block>
    </method>
  </class>
</program>
