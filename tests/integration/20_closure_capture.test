+++closures
***Closure captures variable from outer scope
!I! 0

<?xml version="1.0" encoding="UTF-8"?>
<program language="SOL26" description="Closure capture">
  <class name="Main" parent="Object">
    <method selector="makeAdder:">
      <block arity="1">
        <parameter order="1" name="n"/>
        <assign order="1">
          <var name="adder"/>
          <expr>
            <block arity="1">
              <parameter order="1" name="x"/>
              <assign order="1">
                <var name="_"/>
                <expr>
                  <send selector="plus:">
                    <expr><var name="x"/></expr>
                    <arg order="1"><expr><var name="n"/></expr></arg>
                  </send>
                </expr>
              </assign>
            </block>
          </expr>
        </assign>
        <assign order="2">
          <var name="_"/>
          <expr><var name="adder"/></expr>
        </assign>
      </block>
    </method>
    <method selector="run">
      <block arity="0">
        <assign order="1">
          <var name="add5"/>
          <expr>
            <send selector="makeAdder:">
              <expr><var name="self"/></expr>
              <arg order="1"><expr><literal class="Integer" value="5"/></expr></arg>
            </send>
          </expr>
        </assign>
        <assign order="2">
          <var name="result"/>
          <expr>
            <send selector="value:">
              <expr><var name="add5"/></expr>
              <arg order="1"><expr><literal class="Integer" value="10"/></expr></arg>
            </send>
          </expr>
        </assign>
        <assign order="3">
          <var name="_"/>
          <expr>
            <send selector="show:">
              <expr><literal class="class" value="Transcript"/></expr>
              <arg order="1">
                <expr>
                  <send selector="asString">
                    <expr><var name="result"/></expr>
                  </send>
                </expr>
              </arg>
            </send>
          </expr>
        </assign>
      </block>
    </method>
  </class>
</program>
