+++runtime_error
***division by zero in a nested expression yields error 53
!I! 53

<?xml version="1.0" encoding="UTF-8"?>
<program language="SOL26" description="nested zero division">
  <class name="Main" parent="Object">
    <method selector="run">
      <block arity="0">
        <assign order="1">
          <var name="result"/>
          <expr>
            <send selector="plus:">
              <expr><literal class="Integer" value="10"/></expr>
              <arg order="1">
                <expr>
                  <send selector="//">
                    <expr><literal class="Integer" value="5"/></expr>
                    <arg order="1">
                      <expr><literal class="Integer" value="0"/></expr>
                    </arg>
                  </send>
                </expr>
              </arg>
            </send>
          </expr>
        </assign>
      </block>
    </method>
  </class>
</program>