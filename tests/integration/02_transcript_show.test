+++basic
***Transcript show: prints a string
!I! 0

<?xml version="1.0" encoding="UTF-8"?>
<program language="SOL26" description="Transcript show">
  <class name="Main" parent="Object">
    <method selector="run">
      <block arity="0">
        <assign order="1">
          <var name="_"/>
          <expr>
            <send selector="show:">
              <expr><literal class="class" value="Transcript"/></expr>
              <arg order="1">
                <expr><literal class="String" value="Hello, World!"/></expr>
              </arg>
            </send>
          </expr>
        </assign>
      </block>
    </method>
  </class>
</program>
